# ============================================================
# WOLFTOON NEW — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# NEVER put service_role key in frontend variables (VITE_*).
# ============================================================

# Supabase Project URL (Settings > API > Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (Settings > API > anon public)
# This key is safe for the browser; RLS protects your data.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — local tooling / CI only (NEVER prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
